<Window x:Class="FurniturePlugin.PaiBanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="板件排样 (PAIBAN) — 按材质分别选大板" Height="750" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="板件排样 (PAIBAN)" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="0" Text="按材质分别选择大板 → 渐进式小板优先排版"
                       FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,28,0,0"/>

            <!-- ── 按材质分别配置大板规格 ── -->
            <GroupBox Grid.Row="1" Header="大板规格配置（按材质分别勾选）" Margin="0,0,0,10">
                <StackPanel>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="MaterialConfigsList" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                        Margin="0,0,0,8" Padding="10,8">
                                    <StackPanel>
                                        <!-- 材质名称标题 -->
                                        <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">
                                            <Run Text="▌ "/><Run Text="{Binding MaterialName}"/>
                                        </TextBlock>

                                        <!-- 常规规格勾选 -->
                                        <WrapPanel Margin="0,0,0,4">
                                            <CheckBox Content="2440×1220" IsChecked="{Binding Use2440x1220}"
                                                      Margin="0,0,12,2" FontSize="12"/>
                                            <CheckBox Content="2745×1220" IsChecked="{Binding Use2745x1220}"
                                                      Margin="0,0,12,2" FontSize="12"/>
                                            <CheckBox Content="2800×1220" IsChecked="{Binding Use2800x1220}"
                                                      Margin="0,0,12,2" FontSize="12"/>
                                            <CheckBox Content="2800×2080" IsChecked="{Binding Use2800x2080}"
                                                      Margin="0,0,12,2" FontSize="12"/>
                                            <CheckBox Content="3050×1220" IsChecked="{Binding Use3050x1220}"
                                                      Margin="0,0,12,2" FontSize="12"/>
                                        </WrapPanel>

                                        <!-- 自定义规格输入 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                            <TextBlock Text="自定义:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                            <TextBox Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="65" Height="22" FontSize="11"/>
                                            <TextBlock Text=" × " VerticalAlignment="Center" FontSize="11"/>
                                            <TextBox Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="65" Height="22" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="mm" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
                                            <Button Content="添加" Width="45" Height="22" FontSize="11"
                                                    Click="AddCustomSpecForMaterial_Click" Tag="{Binding}"/>
                                        </StackPanel>

                                        <!-- 已添加的自定义规格列表 -->
                                        <ItemsControl ItemsSource="{Binding CustomSpecs}" Margin="20,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                        <TextBlock Text="{Binding Label}" Width="130"
                                                                   VerticalAlignment="Center" FontSize="11"/>
                                                        <Button Content="✕" Width="30" Height="18" FontSize="9"
                                                                Click="RemoveCustomSpecForMaterial_Click"
                                                                Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Name="NoMaterialHint2" Text="（未检测到材质信息的板件）"
                           Foreground="Gray" Margin="10,4,10,8" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>

            <!-- ── 排样参数 ── -->
            <GroupBox Grid.Row="2" Header="排样参数" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="板件间距:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="PartSpacingTextBox" Text="5" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="边缘余量:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="EdgeMarginTextBox" Text="5" Margin="0,4,0,2"/>
                </Grid>
            </GroupBox>

            <!-- ── 排版选项 ── -->
            <GroupBox Grid.Row="3" Header="排版选项" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <CheckBox Name="AllowRotateCheckBox" Content="允许90°旋转（纹路方向允许时）" IsChecked="True" Margin="0,0,0,6"/>
                    <CheckBox Name="GroupByMaterialCheckBox" Content="按材质+厚度分组排样（三维分类优化）" IsChecked="True" Margin="0,0,0,6"/>
                    <CheckBox Name="ExportCsvCheckBox" Content="导出排样清单CSV" IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <!-- ── 360°旋转材质 ── -->
            <GroupBox Grid.Row="4" Header="允许360°自由旋转的材质（不限纹理）" Margin="0,0,0,10">
                <StackPanel>
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="10">
                    <ItemsControl Name="MaterialRotationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,1,0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Name="NoRotateHint" Text="（无材质可选）" Foreground="Gray"
                           Margin="10,4,10,8" Visibility="Collapsed"/>
                </StackPanel>
            </GroupBox>

            <!-- ── 严格全局优化（阶段1骨架） ── -->
            <GroupBox Grid.Row="5" Header="严格全局优化（慢）" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="求解模式:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Name="SolveModeComboBox" SelectedIndex="0" Margin="0,2,0,2">
                        <ComboBoxItem Content="启发式快速"/>
                        <ComboBoxItem Content="严格全局优化(CP-SAT)"/>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="时间上限(秒):" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBox Name="GlobalOptTimeLimitTextBox" Text="120" Width="90"/>
                        <CheckBox Name="ShowOptRunWindowCheckBox" Content="显示优化运行窗口(预留)" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="异形PoC:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,2">
                        <CheckBox Name="EnableIrregularPocCheckBox" Content="启用异形严格优化PoC" IsChecked="True" VerticalAlignment="Center"/>
                        <TextBlock Text="阈值:" Margin="12,0,4,0" VerticalAlignment="Center"/>
                        <TextBox Name="IrregularPocThresholdTextBox" Text="20" Width="70"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ── 说明 ── -->
            <GroupBox Grid.Row="6" Header="排样说明" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                           Text="★ 按材质分别勾选可用大板规格。&#x0a;★ 渐进式：每个材质从小板开始排版，大件才用大板。&#x0a;★ 排不下的板件会弹窗列出明细。&#x0a;★ 异形件参与排版，360°旋转材质可勾选。"/>
            </GroupBox>

            <!-- ── 按钮 ── -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Name="OkButton" Content="开始排样" Width="120" Height="40"
                        Click="OkButton_Click" Margin="0,0,15,0" FontWeight="Bold"
                        Background="#FF4CAF50" Foreground="White"/>
                <Button Name="CancelButton" Content="取消" Width="80" Height="40" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
