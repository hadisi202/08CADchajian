<Window x:Class="FurniturePlugin.HardwareTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从模板添加五金件" Height="500" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="dgTemplates"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="70"/>
                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="40"/>
                <DataGridTextColumn Header="参考价" Binding="{Binding UnitPrice, StringFormat=F2}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="数量:" VerticalAlignment="Center" Margin="3"/>
            <TextBox Grid.Column="1" x:Name="txtQuantity" Text="1" Margin="3"/>
            <TextBlock Grid.Column="2" Text="订单号:" VerticalAlignment="Center" Margin="3"/>
            <TextBox Grid.Column="3" x:Name="txtOrderId" Margin="3"/>
            <TextBlock Grid.Column="4" Text="柜号:" VerticalAlignment="Center" Margin="3"/>
            <TextBox Grid.Column="5" x:Name="txtCabinetId" Margin="3"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" x:Name="btnOK" Click="BtnOK_Click" Padding="20,5" Margin="3"/>
            <Button Content="取消" x:Name="btnCancel" Click="BtnCancel_Click" Padding="20,5" Margin="3"/>
        </StackPanel>
    </Grid>
</Window>
