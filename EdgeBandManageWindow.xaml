<Window x:Class="FurniturePlugin.EdgeBandManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="封边详细管理" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 批量设置 -->
        <GroupBox Grid.Row="0" Header="批量封边设置" Margin="0,0,0,5" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="上边封边:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbEdgeTop" IsEditable="True" Margin="0,3"/>
                    <CheckBox x:Name="chkApplyTop" Content="应用到选中板件" IsChecked="True"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="下边封边:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbEdgeBottom" IsEditable="True" Margin="0,3"/>
                    <CheckBox x:Name="chkApplyBottom" Content="应用到选中板件" IsChecked="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="左边封边:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbEdgeLeft" IsEditable="True" Margin="0,3"/>
                    <CheckBox x:Name="chkApplyLeft" Content="应用到选中板件" IsChecked="True"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="右边封边:" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbEdgeRight" IsEditable="True" Margin="0,3"/>
                    <CheckBox x:Name="chkApplyRight" Content="应用到选中板件" IsChecked="True"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 板件列表 -->
        <DataGrid Grid.Row="1" x:Name="dgPanels" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" FontSize="13"
                  SelectionMode="Extended" AlternatingRowBackground="#F5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="板件名称" Binding="{Binding PanelName}" Width="120"/>
                <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="100"/>
                <DataGridTextColumn Header="长" Binding="{Binding ExtraLength, StringFormat=F1}" Width="55"/>
                <DataGridTextColumn Header="宽" Binding="{Binding ExtraWidth, StringFormat=F1}" Width="55"/>
                <DataGridTextColumn Header="厚" Binding="{Binding Height, StringFormat=F1}" Width="40"/>
                <DataGridTextColumn Header="上封边" Binding="{Binding EdgeTop}" Width="80"/>
                <DataGridTextColumn Header="下封边" Binding="{Binding EdgeBottom}" Width="80"/>
                <DataGridTextColumn Header="左封边" Binding="{Binding EdgeLeft}" Width="80"/>
                <DataGridTextColumn Header="右封边" Binding="{Binding EdgeRight}" Width="80"/>
                <DataGridTextColumn Header="封边数" Binding="{Binding EdgeBandCount}" Width="50"/>
                <DataGridTextColumn Header="封边描述" Binding="{Binding EdgeBanding}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
            <Button Content="应用封边" x:Name="btnApply" Click="BtnApply_Click" 
                    Padding="15,5" Margin="3" Background="#4CAF50" Foreground="White"/>
            <Button Content="清除选中封边" x:Name="btnClear" Click="BtnClear_Click" 
                    Padding="15,5" Margin="3"/>
            <Button Content="按板件类型自动设置" x:Name="btnAutoSet" Click="BtnAutoSet_Click" 
                    Padding="15,5" Margin="3" Background="#2196F3" Foreground="White"/>
            <Button Content="刷新" x:Name="btnRefresh" Click="BtnRefresh_Click" 
                    Padding="15,5" Margin="3"/>
            <Button Content="关闭" x:Name="btnClose" Click="BtnClose_Click" 
                    Padding="15,5" Margin="3"/>
        </StackPanel>
    </Grid>
</Window>
