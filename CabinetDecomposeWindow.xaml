<Window x:Class="FurniturePlugin.CabinetDecomposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柜体自动拆单" Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 参数配置区 -->
        <Expander Grid.Row="0" Header="柜体参数" IsExpanded="True" Margin="0,0,0,5">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 基本信息 -->
                    <GroupBox Grid.Row="0" Header="基本信息" Margin="0,0,0,5" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="3">
                                <TextBlock Text="柜体宽度(mm):"/>
                                <TextBox x:Name="txtWidth" Text="800"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="3">
                                <TextBlock Text="柜体深度(mm):"/>
                                <TextBox x:Name="txtDepth" Text="600"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="3">
                                <TextBlock Text="柜体高度(mm):"/>
                                <TextBox x:Name="txtHeight" Text="2400"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="3">
                                <TextBlock Text="板件厚度(mm):"/>
                                <TextBox x:Name="txtThickness" Text="18"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4" Margin="3">
                                <TextBlock Text="背板厚度(mm):"/>
                                <TextBox x:Name="txtBackThickness" Text="9"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="5" Margin="3">
                                <TextBlock Text="踢脚高度(mm):"/>
                                <TextBox x:Name="txtKickHeight" Text="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="3">
                                <TextBlock Text="订单号:"/>
                                <TextBox x:Name="txtOrderId"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="3">
                                <TextBlock Text="柜号:"/>
                                <TextBox x:Name="txtCabinetId"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="3">
                                <TextBlock Text="房间:"/>
                                <TextBox x:Name="txtRoomId"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="3">
                                <TextBlock Text="主板材质:"/>
                                <TextBox x:Name="txtMaterial" Text="18mm多层实木板"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="3">
                                <TextBlock Text="背板材质:"/>
                                <TextBox x:Name="txtBackMaterial" Text="9mm密度板"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 结构选项 -->
                    <GroupBox Grid.Row="1" Header="结构选项" Margin="0,0,0,5" Padding="3">
                        <WrapPanel>
                            <CheckBox x:Name="chkHasBackPanel" Content="有背板" IsChecked="True" Margin="8,3"/>
                            <CheckBox x:Name="chkBackPanelInsert" Content="背板嵌入" IsChecked="True" Margin="8,3"/>
                            <CheckBox x:Name="chkHasDoor" Content="有门板" IsChecked="True" Margin="8,3"/>
                            <CheckBox x:Name="chkHasDrawer" Content="有抽屉" IsChecked="False" Margin="8,3"/>
                            <CheckBox x:Name="chkHasKickPlate" Content="有踢脚板" IsChecked="True" Margin="8,3"/>
                            <CheckBox x:Name="chkShelfFixed" Content="层板固定" IsChecked="True" Margin="8,3"/>
                        </WrapPanel>
                    </GroupBox>

                    <!-- 层板/门板/抽屉 -->
                    <GroupBox Grid.Row="2" Header="层板/门板/抽屉" Margin="0,0,0,5" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="3">
                                <TextBlock Text="层板数量:"/>
                                <TextBox x:Name="txtShelfCount" Text="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3">
                                <TextBlock Text="层板厚度(mm):"/>
                                <TextBox x:Name="txtShelfThickness" Text="18"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3">
                                <TextBlock Text="门板数量:"/>
                                <TextBox x:Name="txtDoorCount" Text="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="3">
                                <TextBlock Text="门板厚度(mm):"/>
                                <TextBox x:Name="txtDoorThickness" Text="18"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="3">
                                <TextBlock Text="抽屉数量:"/>
                                <TextBox x:Name="txtDrawerCount" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Margin="3">
                                <TextBlock Text="抽屉高度(mm):"/>
                                <TextBox x:Name="txtDrawerHeight" Text="150"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 封边配置 -->
                    <GroupBox Grid.Row="3" Header="封边配置" Margin="0,0,0,5" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="3">
                                <TextBlock Text="侧板封边材料:"/>
                                <TextBox x:Name="txtSideEdgeMaterial" Text="1mm同色封边"/>
                                <CheckBox x:Name="chkSideEdgeFront" Content="侧板前边封边" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="chkSideEdgeBack" Content="侧板后边封边" IsChecked="False" Margin="0,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3">
                                <TextBlock Text="顶底板封边材料:"/>
                                <TextBox x:Name="txtTopBottomEdgeMaterial" Text="1mm同色封边"/>
                                <CheckBox x:Name="chkTopBottomEdgeFront" Content="顶底板前边封边" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="chkTopBottomEdgeBack" Content="顶底板后边封边" IsChecked="False" Margin="0,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="3">
                                <TextBlock Text="层板封边材料:"/>
                                <TextBox x:Name="txtShelfEdgeMaterial" Text="1mm同色封边"/>
                                <CheckBox x:Name="chkShelfEdgeFront" Content="层板前边封边" IsChecked="True" Margin="0,3"/>
                                <CheckBox x:Name="chkShelfEdgeBack" Content="层板后边封边" IsChecked="False" Margin="0,3"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>
        </Expander>

        <!-- 拆单结果 -->
        <GroupBox Grid.Row="1" Header="拆单结果" Margin="0,0,0,5">
            <DataGrid x:Name="dgResult" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" FontSize="13" AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="板件类型" Binding="{Binding PanelType}" Width="90"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding PanelName}" Width="120"/>
                    <DataGridTextColumn Header="长度(mm)" Binding="{Binding Length, StringFormat=F1}" Width="75"/>
                    <DataGridTextColumn Header="宽度(mm)" Binding="{Binding Width, StringFormat=F1}" Width="75"/>
                    <DataGridTextColumn Header="厚度(mm)" Binding="{Binding Thickness, StringFormat=F1}" Width="65"/>
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="45"/>
                    <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="110"/>
                    <DataGridTextColumn Header="封边" Binding="{Binding EdgeInfo}" Width="*"/>
                    <DataGridTextColumn Header="三合一孔" Binding="{Binding NeedsConnectorHoles}" Width="60"/>
                    <DataGridTextColumn Header="层板托孔" Binding="{Binding NeedsShelfPinHoles}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="计算拆单" x:Name="btnCalculate" Click="BtnCalculate_Click" 
                    Padding="15,5" Margin="3" Background="#2196F3" Foreground="White" FontSize="14"/>
            <Button Content="创建CAD实体" x:Name="btnCreateCad" Click="BtnCreateCad_Click" 
                    Padding="15,5" Margin="3" Background="#4CAF50" Foreground="White" FontSize="14"/>
            <Button Content="添加五金件" x:Name="btnAddHardware" Click="BtnAddHardware_Click" 
                    Padding="15,5" Margin="3" FontSize="14"/>
            <Button Content="关闭" x:Name="btnClose" Click="BtnClose_Click" 
                    Padding="15,5" Margin="3" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
