<Window x:Class="FurniturePlugin.CabinetCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柜体板件创建器" Height="650" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="2,5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2,5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 柜体尺寸 -->
        <GroupBox Grid.Row="0" Header="柜体外包围尺寸 (mm)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="宽度(W):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtWidth" Text="800"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="高度(H):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtHeight" Text="2400"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="深度(D):" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDepth" Text="600"/>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="板厚:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtThickness" Text="18"/>
            </Grid>
        </GroupBox>

        <!-- 盖法选择 -->
        <GroupBox Grid.Row="1" Header="侧板与顶底板盖法">
            <StackPanel>
                <RadioButton x:Name="RbSideCoverTopBottom" Content="侧盖顶底 (侧板全高，顶底夹中间)" IsChecked="True"/>
                <RadioButton x:Name="RbTopBottomCoverSide" Content="顶底盖侧 (顶底全宽，侧板夹中间)"/>
            </StackPanel>
        </GroupBox>

        <!-- 背板盖法 -->
        <GroupBox Grid.Row="2" Header="背板安装方式">
            <StackPanel>
                <RadioButton x:Name="RbBackExternal" Content="外盖式 (背板盖在左右顶底后面)"/>
                <RadioButton x:Name="RbBackEmbedded" Content="内嵌式 (背板嵌入槽内，后面齐平)" IsChecked="True"/>
                <StackPanel Orientation="Horizontal" Margin="20,5,0,0">
                    <TextBlock Text="背板厚度:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBackThickness" Text="5" Width="60"/>
                    <TextBlock Text="槽深:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="TxtGrooveDepth" Text="7" Width="60"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 收口条和踢脚 -->
        <GroupBox Grid.Row="3" Header="收口条与踢脚">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="ChkLeftEdge" Content="左侧收口条"/>
                    <CheckBox x:Name="ChkRightEdge" Content="右侧收口条"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="ChkTopEdge" Content="顶部收口条"/>
                    <CheckBox x:Name="ChkBottomEdge" Content="底部收口条"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="踢脚设置">
            <StackPanel>
                <CheckBox x:Name="ChkKickboard" Content="添加踢脚" Checked="ChkKickboard_Changed" Unchecked="ChkKickboard_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="20,5,0,0" x:Name="KickboardPanel" IsEnabled="False">
                    <TextBlock Text="踢脚高度:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtKickboardHeight" Text="100" Width="60"/>
                    <TextBlock Text="踢脚内缩:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="TxtKickboardInset" Text="50" Width="60"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 预览信息 -->
        <GroupBox Grid.Row="5" Header="计算结果预览">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtPreview" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
            </ScrollViewer>
        </GroupBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="预览计算" Width="100" Height="30" Margin="5" Click="BtnPreview_Click"/>
            <Button Content="创建板件" Width="100" Height="30" Margin="5" Click="BtnCreate_Click" 
                    Background="#FF4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="取消" Width="80" Height="30" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
