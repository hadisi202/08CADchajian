			attachmentPanelOptions.TopInset = value18;
			attachmentPanelOptions.BottomInset = value19;
			attachmentPanelOptions.FrontInset = value20;
			attachmentPanelOptions.BackInset = value21;
			attachmentPanelOptions.OuterOffset = value22;
			if (panelType.Contains("收口板"))
			{
				if (!TryPromptDouble(editor, "\n杈撳叆L鍨嬪洖鍙ｅ搴?<60>: ", 60.0, allowNegative: false, out var value23))
				{
					return null;
				}
				attachmentPanelOptions.ReturnWidth = value23;
			}
			break;
		}
		case AttachmentZoneType.TopOuter:
