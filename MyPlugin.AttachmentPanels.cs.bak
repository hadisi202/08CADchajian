			if (!TryPromptDouble(editor, "\n杈撳叆涓婂亸绉?涓婃姮涓烘, 涓嬪帇涓鸿礋) <0>: ", 0.0, allowNegative: true, out var value16))
			{
				return null;
			}
			attachmentPanelOptions.LeftInset = value12;
			attachmentPanelOptions.RightInset = value13;
