			attachmentPanelOptions.RightInset = value7;
			attachmentPanelOptions.TopInset = value8;
			attachmentPanelOptions.BottomInset = value9;
			attachmentPanelOptions.OuterOffset = value10;
			if (panelType.Contains("收口板") && zone.ZoneType == AttachmentZoneType.BaseFront)
			{
				if (!TryPromptDouble(editor, "\n杈撳叆L鍨嬪洖鍙ｅ搴?<60>: ", 60.0, allowNegative: false, out var value11))
				{
