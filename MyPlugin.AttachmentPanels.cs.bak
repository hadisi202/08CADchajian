			{
				return null;
			}
			attachmentPanelOptions.PanelHeight = value;
			attachmentPanelOptions.LeftInset = value2;
			attachmentPanelOptions.RightInset = value3;
			attachmentPanelOptions.GroundClearance = value4;
			attachmentPanelOptions.OuterOffset = value5;
