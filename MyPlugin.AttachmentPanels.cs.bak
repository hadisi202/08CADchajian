public partial class MyPlugin
{
	private void AddAttachmentPanelToFrame(Editor editor, Database db)
	{
		PromptPointOptions val = new PromptPointOptions("\n璇风偣鍑绘煖浣撳閮ㄩ檮灞炴澘浠跺弬鑰冨尯鍩? ");
		PromptPointResult point = editor.GetPoint(val);
		if ((int)((PromptResult)point).Status != 5100)
		{
			return;
		}
		Point3d value = point.Value;
		CabinetFrame cabinetFrame = CabinetFrameService.FindFrameForAttachment(value);
		if (cabinetFrame == null)
		{
			editor.WriteMessage("\n未找到可挂接的柜体外框。请在柜体附近点取，或先使用 WKK 创建外框。");
			return;
		}
		AttachmentAddHint attachmentAddHint = cabinetFrame.GetAttachmentAddHint(value);
		if (attachmentAddHint == null || attachmentAddHint.Zone == null)
		{
			editor.WriteMessage("\n无法识别附属板件挂接区域，请尽量点取柜体外侧、顶部、前后或踢脚区域。");
			return;
		}
		editor.WriteMessage("\n妫€娴嬪埌: " + attachmentAddHint.Description);
		editor.WriteMessage("\n  鎸傛帴鍖? " + attachmentAddHint.Zone.DisplayName);
		editor.WriteMessage($"\n  鑷姩灏哄: {attachmentAddHint.PreviewLength:F0}脳{attachmentAddHint.PreviewWidth:F0}脳{attachmentAddHint.PreviewThickness:F0}");
		string panelType = attachmentAddHint.PanelType;
		PromptKeywordOptions val2 = CreateAttachmentConfirmOptions(attachmentAddHint.Zone.ZoneType);
		PromptResult keywords = editor.GetKeywords(val2);
		if ((int)keywords.Status == -5002)
		{
			return;
		}
		if ((int)keywords.Status == 5100)
		{
			switch (keywords.StringResult)
			{
			case "T":
				panelType = "踢脚板";
				break;
			case "S":
				panelType = "收口板";
				break;
			case "F":
				panelType = "辅助板";
				break;
			}
		}
		AttachmentPanelOptions attachmentPanelOptions = PromptAttachmentOptions(editor, cabinetFrame, attachmentAddHint.Zone, panelType);
		if (attachmentPanelOptions == null)
		{
			return;
		}
		string text = ResolveAttachmentZoneConflict(editor, cabinetFrame, attachmentAddHint.Zone);
		if (text == "Cancel")
		{
			return;
		}
		if (text == "Block")
		{
			editor.WriteMessage("\n当前挂接区域已有附属板件，已按唯一性策略阻止重复创建。");
			return;
		}
		List<PanelSlot> list = cabinetFrame.BuildAttachmentPreviewSlots(panelType, attachmentAddHint.Zone, attachmentPanelOptions);
		if (list.Count == 0 || list.Any((PanelSlot slot) => !HasValidPanelGeometry(slot)))
		{
			editor.WriteMessage("\n附属板件参数导致尺寸无效，请调整缩进、离地或偏移量后重试。");
			return;
		}
		try
		{
			ShowPanelPreview(cabinetFrame, list);
			PanelSlot panelSlot = list[0];
			editor.WriteMessage($"\n棰勮灏哄: {panelSlot.ComputedLength:F0}脳{panelSlot.ComputedWidth:F0}脳{panelSlot.ComputedThickness:F0}");
			editor.WriteMessage("\n棰勮鍙傛暟: " + panelSlot.GetAttachmentParameterSummary());
			if (list.Count > 1)
			{
				editor.WriteMessage($"\n预览结构: 已生成 L 型双条收口，共 {list.Count} 块板件。");
			}
			PromptKeywordOptions val3 = new PromptKeywordOptions("\n纭鍒涘缓褰撳墠闄勫睘鏉夸欢? [鏄?Y)/鍚?N)] <Y>: ");
			((PromptOptions)val3).Keywords.Add("Y");
			((PromptOptions)val3).Keywords.Add("N");
			val3.AllowNone = true;
			PromptResult keywords2 = editor.GetKeywords(val3);
			if ((int)keywords2.Status == -5002 || ((int)keywords2.Status == 5100 && keywords2.StringResult == "N"))
			{
				editor.WriteMessage("\n已取消创建附属板件。");
				return;
			}
			List<PanelSlot> slots = new List<PanelSlot>();
			if (text == "Replace")
			{
				slots = cabinetFrame.RemoveAttachmentPanelsByZone(attachmentAddHint.Zone.Id);
			}
			List<PanelSlot> list2 = cabinetFrame.AddAttachmentPanels(panelType, attachmentAddHint.Zone, attachmentPanelOptions);
			if (list2.Count == 0 || list2.Any((PanelSlot slot) => !HasValidPanelGeometry(slot)))
			{
				foreach (PanelSlot item in list2)
				{
					cabinetFrame.RemovePanel(item.PanelId);
				}
				editor.WriteMessage("\n附属板件尺寸无效，已停止创建。");
				return;
			}
			foreach (PanelSlot item2 in list2)
			{
				CabinetFrameService.InheritInfoFromNeighbors(cabinetFrame, item2);
			}
			Transaction val4 = db.TransactionManager.StartTransaction();
			try
			{
				BlockTable val5 = (BlockTable)val4.GetObject(db.BlockTableId, (OpenMode)0);
				BlockTableRecord modelSpace = (BlockTableRecord)val4.GetObject(((SymbolTable)val5)[BlockTableRecord.ModelSpace], (OpenMode)1);
				EraseSlotsFromDrawing(db, val4, slots);
				foreach (PanelSlot item3 in list2)
				{
					CreatePanelSolidEntity(cabinetFrame, item3, modelSpace, val4);
				}
				val4.Commit();
			}
			finally
			{
				((IDisposable)val4)?.Dispose();
			}
			CabinetFrameService.SaveFrame(cabinetFrame);
			PanelSlot panelSlot2 = list2[0];
			Point3d origin = cabinetFrame.Origin;
			double value2 = origin.X + panelSlot2.PosX;
			origin = cabinetFrame.Origin;
			double value3 = origin.Y + panelSlot2.PosY;
			origin = cabinetFrame.Origin;
			double value4 = origin.Z + panelSlot2.PosZ;
			editor.WriteMessage($"\n宸叉坊鍔?{panelSlot2.PanelType}: {panelSlot2.ComputedLength:F0}脳{panelSlot2.ComputedWidth:F0}脳{panelSlot2.ComputedThickness:F0}");
			editor.WriteMessage($"\n  瑁佸垏灏哄: {panelSlot2.CuttingLength:F1}脳{panelSlot2.CuttingWidth:F1}脳{panelSlot2.ComputedThickness:F0}");
			editor.WriteMessage($"\n  浣嶇疆: ({value2:F0},{value3:F0},{value4:F0})");
			editor.WriteMessage("\n  鍙傛暟: " + panelSlot2.GetAttachmentParameterSummary());
			if (list2.Count > 1)
			{
				editor.WriteMessage($"\n  结构: 已按 L 型双条收口创建 {list2.Count} 块板件。");
			}
			editor.WriteMessage("\n  柜号/房间/材质/封边信息已自动补齐。");
		}
		finally
		{
			ClearAttachmentPreview();
		}
	}

	private static PromptKeywordOptions CreateAttachmentConfirmOptions(AttachmentZoneType zoneType)
	{
		string text = ((zoneType == AttachmentZoneType.BaseFront) ? "\n纭娣诲姞闄勫睘鏉夸欢? [鏄?Y)/韪㈣剼鏉?T)/杈呭姪鏉?F)] <Y>: " : ((zoneType != AttachmentZoneType.LeftOuter && zoneType != AttachmentZoneType.RightOuter) ? "\n纭娣诲姞闄勫睘鏉夸欢? [鏄?Y)/杈呭姪鏉?F)/鏀跺彛鏉?S)] <Y>: " : "\n纭娣诲姞闄勫睘鏉夸欢? [鏄?Y)/鏀跺彛鏉?S)/杈呭姪鏉?F)] <Y>: "));
		PromptKeywordOptions val = new PromptKeywordOptions(text);
		((PromptOptions)val).Keywords.Add("Y");
		if (zoneType == AttachmentZoneType.BaseFront)
		{
			((PromptOptions)val).Keywords.Add("T");
			((PromptOptions)val).Keywords.Add("F");
		}
		else
		{
			((PromptOptions)val).Keywords.Add("S");
			((PromptOptions)val).Keywords.Add("F");
		}
		val.AllowNone = true;
		return val;
	}

	private static AttachmentPanelOptions PromptAttachmentOptions(Editor editor, CabinetFrame frame, AttachmentZone zone, string panelType)
