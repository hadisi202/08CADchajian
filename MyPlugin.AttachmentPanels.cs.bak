			if (!TryPromptDouble(editor, "\n杈撳叆宸︾缉杩?<0>: ", 0.0, allowNegative: false, out var value12))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆鍙崇缉杩?<0>: ", 0.0, allowNegative: false, out var value13))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆鍓嶇缉杩?<0>: ", 0.0, allowNegative: false, out var value14))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆鍚庣缉杩?<0>: ", 0.0, allowNegative: false, out var value15))
