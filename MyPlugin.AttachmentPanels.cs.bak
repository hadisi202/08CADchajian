		default:
		{
			if (!TryPromptDouble(editor, "\n杈撳叆宸︾缉杩?<0>: ", 0.0, allowNegative: false, out var value6))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆鍙崇缉杩?<0>: ", 0.0, allowNegative: false, out var value7))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆涓婄缉杩?<0>: ", 0.0, allowNegative: false, out var value8))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆涓嬬缉杩?绂诲湴 <0>: ", 0.0, allowNegative: false, out var value9))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆澶栧亸绉?澶栧嚫涓烘, 鍐呴€€涓鸿礋) <0>: ", 0.0, allowNegative: true, out var value10))
			{
