		if (panelType.Contains("踢脚板"))
		{
			if (!TryPromptDouble(editor, "\n杈撳叆韪㈣剼鏉块珮搴?<80>: ", frame.KickPanelHeight, allowNegative: false, out var value))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆宸︾缉杩?<0>: ", 0.0, allowNegative: false, out var value2))
			{
				return null;
			}
			if (!TryPromptDouble(editor, "\n杈撳叆鍙崇缉杩?<0>: ", 0.0, allowNegative: false, out var value3))
