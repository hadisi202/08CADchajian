<Window x:Class="FurniturePlugin.PanelInfoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="板件信息列表(哈迪斯模式)"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="800"
        MinHeight="500"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Button Grid.Column="1"
                                        Content="▼"
                                        Width="16"
                                        Height="16"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        FontSize="9"
                                        Foreground="#107C10"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Click="FilterHeaderButton_Click"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
        </Style>
    </Window.Resources>
    
    <Border Background="White" Margin="10" CornerRadius="8" BorderBrush="#E1E1E1" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="板件信息列表" FontSize="18" FontWeight="Bold" 
                       Foreground="#323130" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            
            <!-- 统计信息 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="总计: " FontWeight="SemiBold" Foreground="#605E5C"/>
                <TextBlock x:Name="TotalCountTextBlock" Text="0" FontWeight="Bold" Foreground="#0078D4"/>
                <TextBlock Text="个板件，其中 " Margin="5,0,0,0" Foreground="#605E5C"/>
                <TextBlock x:Name="ValidCountTextBlock" Text="0" FontWeight="Bold" Foreground="#107C10"/>
                <TextBlock Text="个有信息，" Foreground="#605E5C"/>
                <TextBlock x:Name="EmptyCountTextBlock" Text="0" FontWeight="Bold" Foreground="#D13438"/>
                <TextBlock Text="个无信息" Foreground="#605E5C"/>
            </StackPanel>
            
            <!-- 数据表格 -->
            <DataGrid Grid.Row="2"
                      x:Name="PanelInfoDataGrid"
                      Margin="0,5"
                      CellEditEnding="PanelInfoDataGrid_CellEditEnding"
                      SelectionChanged="PanelInfoDataGrid_SelectionChanged"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="50">
                        <DataGridTemplateColumn.SortMemberPath>IsSelected</DataGridTemplateColumn.SortMemberPath>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" SortMemberPath="Index" Width="45" IsReadOnly="True" />
                    <DataGridTextColumn Header="实体ID" Binding="{Binding EntityId}" SortMemberPath="EntityId" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="板件类型" Binding="{Binding ShapeType}" SortMemberPath="ShapeType" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="实体用途" Binding="{Binding EntityKindDisplay}" SortMemberPath="EntityKindDisplay" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="排版忽略" Binding="{Binding ExcludeFromPaiBanDisplay}" SortMemberPath="ExcludeFromPaiBanDisplay" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" SortMemberPath="OrderId" Width="80" />
                    <DataGridTextColumn Header="柜号" Binding="{Binding CabinetId}" SortMemberPath="CabinetId" Width="60" />
                    <DataGridTextColumn Header="房间号" Binding="{Binding RoomId}" SortMemberPath="RoomId" Width="60" />
                    <DataGridTextColumn Header="板件名称" Binding="{Binding PanelName}" SortMemberPath="PanelName" Width="100" />
                    <DataGridTextColumn Header="材质" Binding="{Binding Material}" SortMemberPath="Material" Width="90" />
                    <DataGridTextColumn Header="长度(mm)" Binding="{Binding Length, StringFormat=F1}" SortMemberPath="Length" Width="70" />
                    <DataGridTextColumn Header="宽度(mm)" Binding="{Binding Width, StringFormat=F1}" SortMemberPath="Width" Width="70" />
                    <DataGridTextColumn Header="厚度(mm)" Binding="{Binding Height, StringFormat=F1}" SortMemberPath="Height" Width="70" />
                    <DataGridTemplateColumn Header="锁定" Width="45">
                        <DataGridTemplateColumn.SortMemberPath>IsLocked</DataGridTemplateColumn.SortMemberPath>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsLocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="裁切长(mm)" Binding="{Binding CuttingLength, StringFormat=F1}" SortMemberPath="CuttingLength" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="裁切宽(mm)" Binding="{Binding CuttingWidth, StringFormat=F1}" SortMemberPath="CuttingWidth" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="裁切厚(mm)" Binding="{Binding CuttingHeight, StringFormat=F1}" SortMemberPath="CuttingHeight" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" SortMemberPath="Quantity" Width="45" />
                    <DataGridTextColumn Header="面积(㎡)" Binding="{Binding Area, StringFormat=F4}" SortMemberPath="Area" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="上封边" Binding="{Binding EdgeTop}" SortMemberPath="EdgeTop" Width="70" />
                    <DataGridTextColumn Header="下封边" Binding="{Binding EdgeBottom}" SortMemberPath="EdgeBottom" Width="70" />
                    <DataGridTextColumn Header="左封边" Binding="{Binding EdgeLeft}" SortMemberPath="EdgeLeft" Width="70" />
                    <DataGridTextColumn Header="右封边" Binding="{Binding EdgeRight}" SortMemberPath="EdgeRight" Width="70" />
                    <DataGridTextColumn Header="纹路" Binding="{Binding TextureDirection}" SortMemberPath="TextureDirection" Width="65" IsReadOnly="True" />
                    <DataGridTextColumn Header="五金" Binding="{Binding HasHardware}" SortMemberPath="HasHardware" Width="55" IsReadOnly="True" />
                    <DataGridTextColumn Header="油漆" Binding="{Binding Paint}" SortMemberPath="Paint" Width="70" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" SortMemberPath="Remarks" Width="120" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" SortMemberPath="Status" Width="60" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- 统计信息面板 -->
            <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4" Margin="0,10,0,10" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 板件总数统计 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="板件总数：" FontWeight="SemiBold" Foreground="#605E5C" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalCountTextBlock" Text="0" FontWeight="Bold" Foreground="#0078D4" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="个" Foreground="#605E5C" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 面积总和统计 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="总面积：" FontWeight="SemiBold" Foreground="#605E5C" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatTotalAreaTextBlock" Text="0.0000" FontWeight="Bold" Foreground="#107C10" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="㎡" Foreground="#605E5C" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                    
                    <!-- 封边长度统计 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="封边长度：" FontWeight="SemiBold" Foreground="#605E5C" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatEdgeLengthTextBlock" Text="0.00" FontWeight="Bold" Foreground="#D13438" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="m" Foreground="#605E5C" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 按钮区域 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <CheckBox x:Name="HighlightOnlyCheckBox" Content="只高亮不缩放"
                          VerticalAlignment="Center" Margin="5,0,10,0"/>
                <Button Content="全选" Width="80" Click="SelectAllButton_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="全不选" Width="80" Click="UnselectAllButton_Click" Style="{StaticResource SecondaryButton}"/>
                
                <Button Content="自动获取尺寸" Width="100" Click="AutoGetSizeButton_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="批量修改" Width="80" Click="BatchEditButton_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="确定" Width="80" Click="SaveButton_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                <Button Content="刷新" Width="80" Click="RefreshButton_Click" Style="{StaticResource SecondaryButton}"/>
                <Button Content="导出CSV" Width="80" Click="ExportButton_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="导出五金" Width="90" Click="ExportHardwareButton_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="关闭" Width="80" Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </StackPanel>

            <Popup x:Name="HeaderFilterPopup"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        MinWidth="280"
                        MaxWidth="360">
                    <StackPanel>
                        <TextBlock x:Name="HeaderFilterTitleTextBlock"
                                   Text="筛选"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#323130"/>
                        <TextBox x:Name="HeaderFilterSearchTextBox"
                                 Margin="0,10,0,6"
                                 TextChanged="HeaderFilterSearchTextBox_TextChanged"
                                 ToolTip="输入关键字筛选候选值"/>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="升序" Click="SortAscendingButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                            <Button Content="降序" Click="SortDescendingButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                            <Button Content="清除排序" Click="ClearSortButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="全选" Click="SelectAllFilterValuesButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                            <Button Content="全不选" Click="ClearAllFilterValuesButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                            <Button Content="清除筛选" Click="ClearHeaderFilterButton_Click" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                        </WrapPanel>
                        <Border BorderBrush="#E1E1E1"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                Height="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HeaderFilterItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding DisplayText}"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="确定" Click="ApplyHeaderFilterButton_Click" Style="{StaticResource PrimaryButton}" Padding="14,4"/>
                            <Button Content="取消" Click="CancelHeaderFilterButton_Click" Style="{StaticResource SecondaryButton}" Padding="14,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
