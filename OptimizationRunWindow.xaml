<Window x:Class="FurniturePlugin.OptimizationRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全局优化运行中"
        Height="320" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="严格全局优化（CP-SAT）正在运行"
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="当前分组:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="GroupTextBlock" Text="-/-" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="已用时:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="ElapsedTextBlock" Text="00:00" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="最佳利用率:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="UtilTextBlock" Text="0.0%" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="最优性Gap:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="GapTextBlock" Text="-" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="当前路径:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="RouteTextBlock" Text="-" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,0">
            <TextBlock Name="StatusTextBlock" Text="初始化中..." TextWrapping="Wrap" Foreground="#444"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Name="AdoptButton" Content="采用当前最优并停止" Width="170" Height="34"
                    Click="AdoptButton_Click" Margin="0,0,12,0"
                    Background="#FF2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Name="CancelButton" Content="取消并回退" Width="120" Height="34"
                    Click="CancelButton_Click"
                    Background="#FFF44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
