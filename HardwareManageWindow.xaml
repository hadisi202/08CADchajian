<Window x:Class="FurniturePlugin.HardwareManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="五金件管理" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选区域 -->
        <GroupBox Grid.Row="0" Header="筛选条件" Margin="0,0,0,5" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="订单号:" VerticalAlignment="Center" Margin="3"/>
                <TextBox Grid.Column="1" x:Name="txtFilterOrder" Margin="3"/>
                <TextBlock Grid.Column="2" Text="柜号:" VerticalAlignment="Center" Margin="3"/>
                <TextBox Grid.Column="3" x:Name="txtFilterCabinet" Margin="3"/>
                <TextBlock Grid.Column="4" Text="类型:" VerticalAlignment="Center" Margin="3"/>
                <ComboBox Grid.Column="5" x:Name="cmbFilterType" Margin="3"/>
                <Button Grid.Column="6" Content="筛选" x:Name="btnFilter" Click="BtnFilter_Click"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="添加五金件" x:Name="btnAdd" Click="BtnAdd_Click" Background="#4CAF50" Foreground="White"/>
            <Button Content="从模板添加" x:Name="btnAddTemplate" Click="BtnAddTemplate_Click"/>
            <Button Content="编辑" x:Name="btnEdit" Click="BtnEdit_Click"/>
            <Button Content="删除" x:Name="btnDelete" Click="BtnDelete_Click" Background="#f44336" Foreground="White"/>
            <Separator Margin="5,0"/>
            <Button Content="关联板件" x:Name="btnAssociatePanel" Click="BtnAssociatePanel_Click"/>
            <Button Content="取消关联" x:Name="btnUnassociate" Click="BtnUnassociate_Click"/>
            <Separator Margin="5,0"/>
            <Button Content="导出Excel" x:Name="btnExport" Click="BtnExport_Click"/>
            <Button Content="刷新" x:Name="btnRefresh" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- 数据列表 -->
        <DataGrid Grid.Row="2" x:Name="dgHardware" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="类型" Binding="{Binding TypeDisplayName}" Width="70"/>
                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="120"/>
                <DataGridTextColumn Header="品牌" Binding="{Binding Brand}" Width="70"/>
                <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="70"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="50"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="40"/>
                <DataGridTextColumn Header="安装位置" Binding="{Binding PositionDisplayName}" Width="70"/>
                <DataGridTextColumn Header="关联板件" Binding="{Binding AssociatedPanelId}" Width="80"/>
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=F2}" Width="60"/>
                <DataGridTextColumn Header="总价" Binding="{Binding TotalPrice, StringFormat=F2}" Width="60"/>
                <DataGridTextColumn Header="供应商" Binding="{Binding Supplier}" Width="70"/>
                <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="柜号" Binding="{Binding CabinetId}" Width="60"/>
                <DataGridTextColumn Header="房间" Binding="{Binding RoomId}" Width="60"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 统计信息 -->
        <GroupBox Grid.Row="3" Header="统计" Margin="0,5,0,5" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="总数量: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotalCount" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="总种类: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotalTypes" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="总金额: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtTotalPrice" Text="¥0.00"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="已关联板件: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtAssociatedCount" Text="0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 关闭 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="关闭" x:Name="btnClose" Click="BtnClose_Click" Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>
