<Window x:Class="FurniturePlugin.UnplaceableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="排版结果检查"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D7DEEA"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>

        <Style TargetType="Border" x:Key="CardBorderStyle">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF2"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5EAF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F5FA"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#E5EAF2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="排版结果检查中心" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="DialogIntroText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="20"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前查看" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ActiveSectionText" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource AccentSoftBrush}" Width="180" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="总问题数" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Background="#F0FDF4" Width="180" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="数据预检" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="PrecheckCountText" FontSize="22" FontWeight="Bold" Foreground="#166534" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource WarningSoftBrush}" Width="180" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="排不进板件" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="UnplacedCountText" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Background="#F8FAFC" Width="260" Margin="0">
                        <StackPanel>
                            <TextBlock Text="操作提示" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="ActionHintText"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       Foreground="#334155"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="筛选与联动定位" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,10"/>
                <WrapPanel>
                    <TextBox x:Name="KeywordTextBox" TextChanged="FilterControl_Changed"/>
                    <ComboBox x:Name="MaterialFilterComboBox" SelectionChanged="FilterControl_Changed"/>
                    <ComboBox x:Name="PartTypeFilterComboBox" SelectionChanged="FilterControl_Changed"/>
                    <ComboBox x:Name="ReasonFilterComboBox" SelectionChanged="FilterControl_Changed"/>
                    <Button x:Name="ResetFilterButton"
                            Content="清空筛选"
                            Click="ResetFilterButton_Click"
                            Background="#E2E8F0"
                            Foreground="#0F172A"/>
                    <CheckBox x:Name="HighlightOnlyCheckBox"
                              Content="只高亮不缩放"
                              Height="34"
                              Margin="6,0,0,10"
                              VerticalAlignment="Center"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <TextBlock x:Name="FilterSummaryText"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="0">
            <Grid>
                <TabControl x:Name="ResultsTabControl" SelectionChanged="ResultsTabControl_SelectionChanged" Margin="12,8,12,12">
                    <TabItem x:Name="PrecheckTab" Header="数据预检">
                        <Grid Margin="0,8,0,0">
                            <DataGrid x:Name="PrecheckGrid"
                                      SelectionChanged="Grid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60"/>
                                    <DataGridTextColumn Header="实体ID" Binding="{Binding Handle}" Width="90"/>
                                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="110"/>
                                    <DataGridTextColumn Header="柜号" Binding="{Binding CabinetId}" Width="110"/>
                                    <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="120"/>
                                    <DataGridTextColumn Header="板件名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="裁切尺寸(mm)" Binding="{Binding SizeText}" Width="150"/>
                                    <DataGridTextColumn Header="板件类型" Binding="{Binding PartType}" Width="90"/>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PrecheckEmptyHint"
                                       Text="当前没有需要关注的数据预检结果。"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"/>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="UnplacedTab" Header="排不进板件">
                        <Grid Margin="0,8,0,0">
                            <DataGrid x:Name="UnplacedGrid"
                                      SelectionChanged="Grid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60"/>
                                    <DataGridTextColumn Header="实体ID" Binding="{Binding Handle}" Width="90"/>
                                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="110"/>
                                    <DataGridTextColumn Header="柜号" Binding="{Binding CabinetId}" Width="110"/>
                                    <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="120"/>
                                    <DataGridTextColumn Header="板件名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="裁切尺寸(mm)" Binding="{Binding SizeText}" Width="150"/>
                                    <DataGridTextColumn Header="板件类型" Binding="{Binding PartType}" Width="90"/>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="UnplacedEmptyHint"
                                       Text="当前没有排不进的大板件。"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Text="提示：选中列表中的板件后，会在 CAD 中联动高亮并可自动缩放定位。"/>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="GoBackButton"
                            Content="返回上一步"
                            Click="GoBackButton_Click"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"/>
                    <Button x:Name="SkipButton"
                            Content="忽略这些板件并继续"
                            Click="SkipButton_Click"
                            Background="{StaticResource WarningBrush}"
                            Foreground="White"/>
                    <Button x:Name="CancelButton"
                            Content="取消排版"
                            Click="CancelButton_Click"
                            Background="{StaticResource DangerBrush}"
                            Foreground="White"
                            Margin="0"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
