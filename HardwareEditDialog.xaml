<Window x:Class="FurniturePlugin.HardwareEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑五金件" Height="520" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Margin="3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="类型:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbType" Margin="3" DisplayMemberPath="Value" SelectedValuePath="Key"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="型号:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtModel" Margin="3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="品牌:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtBrand" Margin="3"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="材质:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtMaterial" Margin="3"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="数量:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtQuantity" Margin="3"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="单位:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtUnit" Margin="3" Text="个"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="安装位置:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cmbPosition" Margin="3" DisplayMemberPath="Value" SelectedValuePath="Key"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="安装说明:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtInstallDesc" Margin="3" AcceptsReturn="True" Height="45" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="单价:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtUnitPrice" Margin="3"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="供应商:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtSupplier" Margin="3"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="订单号:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="11" Grid.Column="1" x:Name="txtOrderId" Margin="3"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="柜号:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="12" Grid.Column="1" x:Name="txtCabinetId" Margin="3"/>

                <TextBlock Grid.Row="13" Grid.Column="0" Text="房间:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="13" Grid.Column="1" x:Name="txtRoomId" Margin="3"/>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="备注:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="14" Grid.Column="1" x:Name="txtRemarks" Margin="3" AcceptsReturn="True" Height="40" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" x:Name="btnOK" Click="BtnOK_Click" Padding="20,5" Margin="3"/>
            <Button Content="取消" x:Name="btnCancel" Click="BtnCancel_Click" Padding="20,5" Margin="3"/>
        </StackPanel>
    </Grid>
</Window>
