<Window x:Class="FurniturePlugin.TopBottomPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="顶底板参数化建模" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF2E3440" Padding="15,10">
            <TextBlock Text="顶底板参数化建模" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- 主要内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- 基础参数组 -->
                <GroupBox Header="基础参数" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0" Content="柜体宽度(mm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="CabinetWidthTextBox" Text="800" Margin="5" Padding="5"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="柜体深度(mm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="CabinetDepthTextBox" Text="600" Margin="5" Padding="5"/>
                        
                        <Label Grid.Row="2" Grid.Column="0" Content="顶底板厚度(mm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="TopBottomThicknessTextBox" Text="18" Margin="5" Padding="5"/>
                        
                        <Label Grid.Row="3" Grid.Column="0" Content="侧板厚度(mm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="SidePanelThicknessTextBox" Text="18" Margin="5" Padding="5"/>
                    </Grid>
                </GroupBox>
                
                <!-- 盖法选择组 -->
                <GroupBox Header="盖法选择" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <RadioButton Name="TopBottomCoverSideRadio" Content="顶底板盖左右侧板" IsChecked="True" Margin="0,5"/>
                        <RadioButton Name="SideCoverTopBottomRadio" Content="左右侧板盖顶底板" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
                
                <!-- 顶底板配置组 -->
                <GroupBox Header="顶底板配置" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <CheckBox Grid.Row="0" Grid.Column="0" Name="CreateTopPanelCheckBox" Content="创建顶板" IsChecked="True" Margin="0,5"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Name="CreateBottomPanelCheckBox" Content="创建底板" IsChecked="True" Margin="0,5"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="顶板材质:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Name="TopPanelMaterialComboBox" Margin="5" Padding="5">
                            <ComboBoxItem Content="三聚氰胺板" IsSelected="True"/>
                            <ComboBoxItem Content="实木板"/>
                            <ComboBoxItem Content="密度板"/>
                            <ComboBoxItem Content="颗粒板"/>
                        </ComboBox>
                        
                        <Label Grid.Row="2" Grid.Column="0" Content="底板材质:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Name="BottomPanelMaterialComboBox" Margin="5" Padding="5">
                            <ComboBoxItem Content="三聚氰胺板" IsSelected="True"/>
                            <ComboBoxItem Content="实木板"/>
                            <ComboBoxItem Content="密度板"/>
                            <ComboBoxItem Content="颗粒板"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>
                
                <!-- 高级选项组 -->
                <GroupBox Header="高级选项" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <CheckBox Grid.Row="0" Grid.Column="0" Name="HasTopKickbackCheckBox" Content="顶板有踢脚线" Margin="0,5"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Name="HasBottomKickbackCheckBox" Content="底板有踢脚线" Margin="0,5"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="踢脚线高度(mm):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="KickbackHeightTextBox" Text="100" Margin="5" Padding="5"/>
                    </Grid>
                </GroupBox>
                
                <!-- 计算结果显示组 -->
                <GroupBox Header="计算结果" Margin="0,0,0,15" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0" Content="顶板尺寸:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="TopPanelSizeTextBlock" Text="800×600×18" VerticalAlignment="Center" Margin="10,0"/>
                        
                        <Label Grid.Row="0" Grid.Column="2" Content="底板尺寸:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Name="BottomPanelSizeTextBlock" Text="800×600×18" VerticalAlignment="Center" Margin="10,0"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="总面积:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="TotalAreaTextBlock" Text="0.96 m²" VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                </GroupBox>
                
                <!-- 识别功能组 -->
                <GroupBox Header="CAD识别功能" Margin="0,0,0,15" Padding="15">
                    <StackPanel>
                        <TextBlock Text="点击识别按钮，然后在CAD中选择参考对象来自动设置参数" 
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#FF666666"/>
                        <Button Name="IdentifyButton" Content="🎯 识别CAD对象" Width="150" Height="40" 
                                Background="#FF9C27B0" Foreground="White" BorderThickness="0" 
                                FontSize="14" FontWeight="Bold" Click="IdentifyButton_Click"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" Background="#FFF0F0F0" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="CalculateButton" Content="重新计算" Width="100" Height="35" Margin="0,0,10,0" 
                        Background="#FF4CAF50" Foreground="White" BorderThickness="0" Click="CalculateButton_Click"/>
                <Button Name="IdentifyQuickButton" Content="🎯 快速识别" Width="100" Height="35" Margin="0,0,10,0" 
                        Background="#FF9C27B0" Foreground="White" BorderThickness="0" Click="IdentifyButton_Click"/>
                <Button Name="CreateButton" Content="创建板件" Width="100" Height="35" Margin="0,0,10,0" 
                        Background="#FFFF9800" Foreground="White" BorderThickness="0" Click="CreateButton_Click"/>
                <Button Name="CancelButton" Content="取消" Width="80" Height="35" 
                        Background="#FF757575" Foreground="White" BorderThickness="0" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>