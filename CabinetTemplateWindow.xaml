<Window x:Class="FurniturePlugin.CabinetTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="柜体模板库" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="分类:" VerticalAlignment="Center" Margin="3"/>
            <ComboBox x:Name="cmbCategory" Width="120" Margin="3" SelectionChanged="CmbCategory_SelectionChanged"/>
            <Button Content="刷新" x:Name="btnRefresh" Click="BtnRefresh_Click" Margin="5,3"/>
        </StackPanel>

        <!-- 模板列表 -->
        <ListBox Grid.Row="1" x:Name="lbTemplates" FontSize="14" Margin="0,0,0,5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Category}" Foreground="#666" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Description}" Foreground="#888"/>
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0" Foreground="#999" FontSize="12">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}×{1}×{2}mm">
                                        <Binding Path="Config.CabinetWidth"/>
                                        <Binding Path="Config.CabinetDepth"/>
                                        <Binding Path="Config.CabinetHeight"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="使用此模板" x:Name="btnUse" Click="BtnUse_Click" 
                    Padding="15,5" Margin="3" Background="#4CAF50" Foreground="White" FontSize="14"/>
            <Button Content="保存当前配置为模板" x:Name="btnSave" Click="BtnSave_Click" 
                    Padding="15,5" Margin="3" FontSize="14"/>
            <Button Content="删除模板" x:Name="btnDelete" Click="BtnDelete_Click" 
                    Padding="15,5" Margin="3" FontSize="14"/>
            <Button Content="关闭" x:Name="btnClose" Click="BtnClose_Click" 
                    Padding="15,5" Margin="3" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
