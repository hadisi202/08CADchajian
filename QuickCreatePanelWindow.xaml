<Window x:Class="FurniturePlugin.QuickCreatePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速创建板件(CJBJ)"
        Width="500"
        Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="450"
        MinHeight="500"
        Background="#F5F5F5"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#107C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
        </Style>
    </Window.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="5">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="快速创建矩形板件" FontSize="16" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,15" HorizontalAlignment="Center"/>
        
        <!-- 搭积木关联 -->
        <GroupBox Grid.Row="1" Header="搭积木关联（可选）" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="外框:" Margin="0,2,5,2"/>
                    <ComboBox Grid.Column="1" x:Name="cmbFrame" Margin="0,2" 
                              SelectionChanged="cmbFrame_SelectionChanged"/>
                    <Button Grid.Column="2" Content="刷新" Click="BtnRefreshFrames_Click" 
                            Style="{StaticResource SecondaryButton}" Margin="5,2"/>
                </Grid>
                <TextBlock x:Name="txtFrameInfo" Text="未选择外框 - 将创建独立板件" 
                           Foreground="#605E5C" FontSize="11" Margin="5,5,0,5"/>
                <TextBlock x:Name="txtSpaceInfo" Text="" 
                           Foreground="#0078D4" FontSize="11" Margin="5,0,0,5" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
        
        <!-- 尺寸输入 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="长度(mm):"/>
            <TextBox Grid.Column="1" x:Name="LengthTextBox" Text="400" Margin="0,5,10,5"/>
            <Label Grid.Column="2" Content="宽度(mm):"/>
            <TextBox Grid.Column="3" x:Name="WidthTextBox" Text="300" Margin="0,5,0,5"/>
        </Grid>
        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="厚度(mm):"/>
            <TextBox Grid.Column="1" x:Name="ThicknessTextBox" Text="18" Margin="0,5,10,5"/>
            <Label Grid.Column="2" Content="水平旋转:"/>
            <TextBox Grid.Column="3" x:Name="HorizontalRotationTextBox" Text="0" Margin="0,5,0,5"/>
        </Grid>
        
        <!-- 垂直旋转行 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="垂直旋转:"/>
            <TextBox Grid.Column="1" x:Name="VerticalRotationTextBox" Text="0" Margin="0,5,10,5"/>
        </Grid>
        
        <!-- 方向选择 -->
        <GroupBox Grid.Row="5" Header="板件方向" Margin="0,15,0,10" Padding="10">
            <StackPanel>
                <RadioButton x:Name="XDirectionRadio" Content="X方向 - 顶底板 (长沿X, 宽沿Y, 厚沿Z)" 
                           IsChecked="True" Margin="0,5"/>
                <RadioButton x:Name="YDirectionRadio" Content="Y方向 - 左右侧板 (厚沿X, 宽沿Y, 长沿Z)" 
                           Margin="0,5"/>
                <RadioButton x:Name="ZDirectionRadio" Content="Z方向 - 背板 (长沿X, 厚沿Y, 宽沿Z)" 
                           Margin="0,5"/>
            </StackPanel>
        </GroupBox>
        
        <!-- 预设尺寸按钮 -->
        <GroupBox Grid.Row="6" Header="常用预设" Margin="0,10" Padding="10">
            <StackPanel>
                <WrapPanel>
                    <Button Content="侧板" Click="PresetButton_Click" Tag="2400,600,18" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    <Button Content="顶底板" Click="PresetButton_Click" Tag="800,600,18" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    <Button Content="层板" Click="PresetButton_Click" Tag="600,300,18" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    <Button Content="背板" Click="PresetButton_Click" Tag="800,2400,9" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    <Button Content="门板" Click="PresetButton_Click" Tag="400,600,18" Style="{StaticResource SecondaryButton}" Margin="2"/>
                    <Button Content="立板" Click="PresetButton_Click" Tag="600,2400,18" Style="{StaticResource SecondaryButton}" Margin="2"/>
                </WrapPanel>
                <CheckBox x:Name="AutoSortDimensionsCheckBox" Content="自动排序尺寸（长>=宽>=厚）" 
                         Margin="5,10,5,5" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>
        
        <!-- 操作按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,15">
            <Button x:Name="OkButton" Content="确定创建" Click="OkButton_Click" 
                    Style="{StaticResource PrimaryButton}" IsDefault="True" 
                    Width="120" Height="35" Margin="10,0"/>
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" 
                    Style="{StaticResource SecondaryButton}" IsCancel="True" 
                    Width="120" Height="35" Margin="10,0"/>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
