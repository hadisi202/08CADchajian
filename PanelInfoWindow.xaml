<Window x:Class="FurniturePlugin.PanelInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="板件属性设置"
        Width="620"
        Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="580"
        MinHeight="750"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3F2F1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="White" Margin="8" CornerRadius="8" BorderBrush="#E1E1E1" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="5">
            <StackPanel Margin="12">

                <!-- 标题 -->
                <TextBlock Text="板件属性设置" FontSize="16" FontWeight="Bold"
                           Foreground="#323130" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <!-- === 基本信息区 === -->
                <Border Style="{StaticResource SectionHeader}" Background="#E8F4FD">
                    <TextBlock Text="基本信息" FontWeight="SemiBold" Foreground="#0078D4" FontSize="12"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="订单号:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="OrderIdTextBox" Margin="0,3,4,3"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="柜号:"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="CabinetIdTextBox" Margin="4,3,0,3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="房间:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoomIdTextBox" Margin="0,3,4,3"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="板件名称:"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="PanelNameTextBox" Margin="4,3,0,3"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="材质:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaterialTextBox" Margin="0,3,4,3"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="板件形状:"/>
                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="PanelShapeComboBox" Margin="4,3,0,3"
                              SelectionChanged="PanelShapeComboBox_SelectionChanged"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="实体用途:"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="EntityKindComboBox" Margin="0,3,4,3"
                              SelectionChanged="EntityKindComboBox_SelectionChanged"/>
                    <CheckBox Grid.Row="3" Grid.Column="3" x:Name="ExcludeFromPaiBanCheckBox"
                              Content="排版时忽略" Margin="4,3,0,3" VerticalAlignment="Center" FontSize="11"/>
                </Grid>

                <!-- === 尺寸信息区 === -->
                <Border Style="{StaticResource SectionHeader}" Background="#F0F7E8">
                    <TextBlock Text="尺寸信息" FontWeight="SemiBold" Foreground="#2E7D32" FontSize="12"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="显示长L:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LengthTextBox" Margin="0,3,2,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="显示宽W:"/>
                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="WidthTextBox" Margin="2,3,2,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="显示厚T:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="HeightTextBox" Margin="0,3,2,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <!-- 裁切尺寸（可编辑，支持公式：L+50, W+T/2, L*(2+10)） -->
                    <Label Grid.Row="1" Grid.Column="3" Content="裁切长:"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="ExtraLengthTextBox" Margin="2,3,2,3"
                             ToolTip="支持公式：L+50, W+T/2, L*(2+10)。空=自动扣封边。L=显示长 W=显示宽 T=显示厚"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="裁切宽:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExtraWidthTextBox" Margin="0,3,2,3"
                             ToolTip="支持公式。空=自动扣封边"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="2" Grid.Column="3" Content="裁切厚:"/>
                    <TextBox Grid.Row="2" Grid.Column="4" x:Name="ExtraHeightTextBox" Margin="2,3,2,3"
                             ToolTip="支持公式。空=自动扣封边"/>
                    <TextBlock Grid.Row="2" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                </Grid>

                <!-- 自动计算按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnCalcDimensions" Content="自动计算尺寸" Click="BtnCalcDimensions_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <Button x:Name="BtnCalcCutting" Content="更新裁切尺寸" Click="BtnCalcCutting_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <CheckBox x:Name="DimensionLockCheckBox" Content="锁定尺寸" IsChecked="{Binding IsDimensionLocked}"
                              Checked="DimensionLockCheckBox_Checked" Unchecked="DimensionLockCheckBox_Unchecked"
                              Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>

                <!-- === 封边信息区 === -->
                <Border Style="{StaticResource SectionHeader}" Background="#FFF3CD">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="封边信息" FontWeight="SemiBold" Foreground="#856404" FontSize="12"/>
                        <TextBlock Text="（封边名称建议以厚度开头：如 0.5*22 爱格W1000 ABS封边条）" Foreground="#999" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="上边封边:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbEdgeTop" IsEditable="True" Margin="0,3,4,3"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="下边封边:"/>
                    <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cmbEdgeBottom" IsEditable="True" Margin="4,3,0,3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="左边封边:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbEdgeLeft" IsEditable="True" Margin="0,3,4,3"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="右边封边:"/>
                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbEdgeRight" IsEditable="True" Margin="4,3,0,3"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnEditEdgeCatalog" Content="自定义封边名称" Click="BtnEditEdgeCatalog_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <Button x:Name="BtnClearEdge" Content="清除全部封边" Click="BtnClearEdge_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <Button x:Name="BtnAllEdge" Content="四边同封0.5mm" Click="BtnAllEdge_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                </StackPanel>

                <!-- === 纹路方向区 === -->
                <Border Style="{StaticResource SectionHeader}" Background="#E8E0F0">
                    <TextBlock Text="纹路方向" FontWeight="SemiBold" Foreground="#6A1B9A" FontSize="12"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <RadioButton x:Name="rbAlongLength" Content="沿长边" IsChecked="True" Margin="10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbAlongWidth" Content="沿宽边" Margin="10,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnToggleTexture" Content="切换纹路" Click="BtnToggleTexture_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11" Margin="15,0,0,0"/>
                    <Button x:Name="BtnShowTexture" Content="显示纹路线" Click="BtnShowTexture_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <Button x:Name="BtnHideTexture" Content="隐藏纹路线" Click="BtnHideTexture_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                </StackPanel>

                <!-- === 圆弧板件参数区 === -->
                <Border x:Name="borderArcParams" Style="{StaticResource SectionHeader}" Background="#FFE0E8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="圆弧板件参数" FontWeight="SemiBold" Foreground="#C2185B" FontSize="12"/>
                        <TextBlock Text="（自动从3D实体检测，展开长=中线弧长+直段）" Foreground="#999" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="gridArcParams" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="内径R:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ArcRadiusTextBox" Margin="0,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                    <Label Grid.Row="0" Grid.Column="3" Content="弧度角:"/>
                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="ArcAngleTextBox" Margin="2,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="°" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="直段1:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArcStraight1TextBox" Margin="0,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                    <Label Grid.Row="1" Grid.Column="3" Content="直段2:"/>
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="ArcStraight2TextBox" Margin="2,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="边长口径:" FontWeight="Bold" Foreground="#C2185B"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ArcLengthReferenceComboBox" Margin="0,3,2,3"
                              SelectionChanged="ArcLengthReferenceComboBox_SelectionChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="" VerticalAlignment="Center"/>
                    <Label Grid.Row="2" Grid.Column="3" Content="当前边长:" FontWeight="Bold" Foreground="#C2185B"/>
                    <TextBox Grid.Row="2" Grid.Column="4" x:Name="ArcUnfoldedTextBox" Margin="2,3,2,3" IsReadOnly="True"
                             FontWeight="Bold" Background="#FFF0F0" Foreground="#C2185B"/>
                    <TextBlock Grid.Row="2" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#C2185B" FontWeight="Bold"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="外线总长:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ArcOuterLengthTextBox" Margin="0,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                    <Label Grid.Row="3" Grid.Column="3" Content="中线总长:"/>
                    <TextBox Grid.Row="3" Grid.Column="4" x:Name="ArcCenterLengthTextBox" Margin="2,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="3" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="内线总长:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ArcInnerLengthTextBox" Margin="0,3,2,3" IsReadOnly="True"
                             Background="#F0F0F0" Foreground="#666666"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#999"/>
                    <Label Grid.Row="4" Grid.Column="3" Content="展开宽:" FontWeight="Bold" Foreground="#C2185B"/>
                    <TextBox Grid.Row="4" Grid.Column="4" x:Name="ArcUnfoldedWidthTextBox" Margin="2,3,2,3" IsReadOnly="True"
                             FontWeight="Bold" Background="#FFF0F0" Foreground="#C2185B"/>
                    <TextBlock Grid.Row="4" Grid.Column="5" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#C2185B" FontWeight="Bold"/>
                </Grid>

                <!-- === 搭积木信息区 === -->
                <Border x:Name="borderBuildingBlock" Style="{StaticResource SectionHeader}" Background="#E3F2FD">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="搭积木信息" FontWeight="SemiBold" Foreground="#1565C0" FontSize="12"/>
                        <TextBlock x:Name="txtBuildingBlockInfo" Text="（非搭积木板件）" Foreground="#999" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="gridBuildingBlock">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="外框ID:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFrameId" IsReadOnly="True" Margin="0,3,4,3"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="空间ID:"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtSpaceId" IsReadOnly="True" Margin="4,3,0,3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="板件朝向:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOrient" IsReadOnly="True" Margin="0,3,4,3"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="背板方式:"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtBackPanelStyle" IsReadOnly="True" Margin="4,3,0,3"/>
                </Grid>

                <Border Style="{StaticResource SectionHeader}" Background="#EDE7F6">
                    <TextBlock Text="五金配置信息" FontWeight="SemiBold" Foreground="#5E35B1" FontSize="12"/>
                </Border>

                <DataGrid x:Name="dgPanelHardware" AutoGenerateColumns="False"
                          CanUserAddRows="False" FontSize="11" MaxHeight="140"
                          SelectionMode="Single" AlternatingRowBackground="#F5F5F5"
                          HeadersVisibility="Column" Margin="0,2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="45"/>
                        <DataGridTextColumn Header="五金名称" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="100"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="55"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="45"/>
                        <DataGridTextColumn Header="颜色" Binding="{Binding Color}" Width="70"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="BtnAddHardwareRow" Content="新增行" Click="BtnAddHardwareRow_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                    <Button x:Name="BtnDeleteHardwareRow" Content="删除行" Click="BtnDeleteHardwareRow_Click"
                            Style="{StaticResource SecondaryButton}" FontSize="11"/>
                </StackPanel>

                <Border x:Name="borderAttachmentParams" Style="{StaticResource SectionHeader}" Background="#FFF0F0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="附属板件参数" FontWeight="SemiBold" Foreground="#C62828" FontSize="12"/>
                        <TextBlock Text="（修改后保存将直接回写并重算实体）" Foreground="#999" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="gridAttachmentParams" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="左缩进:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtAttachLeftInset" Margin="0,3,4,3"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="右缩进:"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtAttachRightInset" Margin="4,3,0,3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="前缩进:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAttachFrontInset" Margin="0,3,4,3"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="后缩进:"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtAttachBackInset" Margin="4,3,0,3"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="上缩进:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAttachTopInset" Margin="0,3,4,3"/>
                    <Label Grid.Row="2" Grid.Column="2" Content="下缩进:"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtAttachBottomInset" Margin="4,3,0,3"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="离地:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAttachGroundClearance" Margin="0,3,4,3"/>
                    <Label Grid.Row="3" Grid.Column="2" Content="外偏移:"/>
                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtAttachOuterOffset" Margin="4,3,0,3"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="板高:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtAttachHeight" Margin="0,3,4,3"/>
                    <Label Grid.Row="4" Grid.Column="2" Content="回口宽:"/>
                    <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtAttachReturnWidth" Margin="4,3,0,3"/>
                </Grid>

                <!-- === 其他信息区 === -->
                <Border Style="{StaticResource SectionHeader}" Background="#F5F5F5">
                    <TextBlock Text="其他信息" FontWeight="SemiBold" Foreground="#666" FontSize="12"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="油漆:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="PaintTextBox" Margin="0,3"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="备注:" VerticalAlignment="Top"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RemarksTextBox"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="40"
                             VerticalScrollBarVisibility="Auto" Margin="0,3"/>
                </Grid>

                <!-- === 操作按钮区 === -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
                    <Button x:Name="OkButton" Content="确定" Width="90" Height="32"
                            Click="OkButton_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="8,0"/>
                    <Button x:Name="CancelButton" Content="取消" Width="90" Height="32"
                            Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="8,0"/>
                    <Button x:Name="SelectPanelButton" Content="选择板件" Width="90" Height="32"
                            Click="SelectPanelButton_Click" Style="{StaticResource SecondaryButton}" Margin="8,0"/>
                </StackPanel>
            </StackPanel>
