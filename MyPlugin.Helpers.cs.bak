	private sealed class EdgeAgg
	{
		public int FrontCount;

		public int BackCount;

		public int SideCount;

		public int FaceSampleCount;

		public readonly List<(Point2d A, Point2d B)> Segments = new List<(Point2d, Point2d)>();

		private readonly HashSet<string> segSet = new HashSet<string>(StringComparer.Ordinal);

		private readonly List<Vector3d> normals = new List<Vector3d>();

		public void AddFace(bool front, bool back, bool side, Vector3d faceNormal)
		{
			FaceSampleCount++;
			if (front)
			{
				FrontCount++;
			}
			else if (back)
			{
				BackCount++;
			}
			else if (side)
			{
				SideCount++;
			}
			if (!(faceNormal.Length > 1E-12))
			{
				return;
			}
			Vector3d val;
			try
			{
				val = faceNormal.GetNormal();
			}
			catch
			{
				val = Vector3d.ZAxis;
			}
			bool flag = false;
			for (int i = 0; i < normals.Count; i++)
			{
				Vector3d val2 = normals[i];
				double num = Math.Abs(val2.DotProduct(val));
				if (num > 0.9995)
				{
					flag = true;
					break;
				}
			}
			if (!flag && normals.Count < 8)
			{
				normals.Add(val);
			}
		}

		public bool IsCrease()
		{
			if (normals.Count < 2)
			{
				return false;
			}
			for (int i = 0; i < normals.Count; i++)
			{
				for (int j = i + 1; j < normals.Count; j++)
				{
					Vector3d val = normals[i];
					double num = Math.Abs(val.DotProduct(normals[j]));
					if (num < 0.9995)
					{
						return true;
					}
				}
			}
			return false;
		}

		public void AddSegment(Point2d a, Point2d b)
		{
			string item = SegmentKey2D(a, b);
			if (!segSet.Contains(item))
			{
				Segments.Add((a, b));
				segSet.Add(item);
			}
		}
	}

