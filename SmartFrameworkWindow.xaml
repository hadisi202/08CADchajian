<Window x:Class="FurniturePlugin.SmartFrameworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能外框架创建" Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closing="Window_Closing">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="智能外框架创建" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- 智能识别区域 -->
            <GroupBox Grid.Row="1" Header="智能获取尺寸" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Name="SelectPanelButton" Content="选择板件" Width="100" Height="35" 
                                Click="SelectPanelButton_Click" Margin="0,0,10,0"/>
                        <Button Name="SelectRegionButton" Content="框选区域" Width="100" Height="35" 
                                Click="SelectRegionButton_Click" Margin="0,0,10,0"/>
                        <Button Name="ManualInputButton" Content="手动输入" Width="100" Height="35" 
                                Click="ManualInputButton_Click"/>
                    </StackPanel>
                    
                    <TextBlock Name="IdentificationResultText" Text="请选择获取方式" 
                               Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <!-- 柜体参数 -->
            <GroupBox Grid.Row="2" Header="柜体参数" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="宽度:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="WidthTextBox" Text="800" Margin="0,2,10,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="高度:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Name="HeightTextBox" Text="2400" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="深度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="DepthTextBox" Text="600" Margin="0,7,10,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="板厚:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Name="ThicknessTextBox" Text="18" Margin="0,7,0,2"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="材质:" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Name="MaterialComboBox" Margin="0,7,0,2">
                        <ComboBoxItem Content="三聚氰胺板" IsSelected="True"/>
                        <ComboBoxItem Content="实木板"/>
                        <ComboBoxItem Content="密度板"/>
                        <ComboBoxItem Content="颗粒板"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <!-- 盖法选择 -->
            <GroupBox Grid.Row="3" Header="盖法" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <RadioButton Name="SideCoverRadio" Content="侧板盖顶底" IsChecked="True" Margin="0,0,30,0"/>
                    <RadioButton Name="TopBottomCoverRadio" Content="顶底盖侧板"/>
                </StackPanel>
            </GroupBox>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Name="CreateFrameworkButton" Content="创建外框架" Width="120" Height="40" 
                        Click="CreateFrameworkButton_Click" Margin="0,0,15,0" FontWeight="Bold"/>
                <Button Name="CancelButton" Content="取消" Width="80" Height="40" 
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>