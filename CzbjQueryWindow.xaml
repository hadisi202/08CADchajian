<Window x:Class="FurniturePlugin.CzbjQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="板件查询(CZBJ)"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="900"
        MinHeight="550"
        Background="#F0F2F5"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D13438"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D13438"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="White" Margin="10" CornerRadius="8" BorderBrush="#D1D1D1" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === 顶部：ID精确查询 === -->
            <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="6" BorderBrush="#E1E4E8" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="模型ID查询" FontWeight="Bold" FontSize="14" Foreground="#0078D4" VerticalAlignment="Center"/>
                        <TextBlock Text="（支持十进制、十六进制、(12345) 格式）" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="IdSearchBox" Grid.Column="1"
                             Padding="10,7" FontSize="14" Margin="0,0,10,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#0078D4"
                             ToolTip="输入实体ID/Handle后按回车或点击查询"/>
                    <Button x:Name="IdSearchBtn" Grid.Column="2" Content="查 询"
                            Style="{StaticResource PrimaryButton}"
                            Click="IdSearchBtn_Click" MinWidth="80"/>
                    <Button x:Name="ClearIdBtn" Grid.Column="3" Content="清除"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearIdBtn_Click" MinWidth="60"/>
                </Grid>
            </Border>

            <!-- === 筛选面板 === -->
            <Border Grid.Row="1" Background="#FAFBFC" CornerRadius="6" BorderBrush="#E1E4E8" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 折叠/展开标题栏 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="多维度筛选" FontWeight="Bold" FontSize="13" Foreground="#0078D4" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveFilterCountText" Text="" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="ToggleFilterBtn" Grid.Column="1" Content="收起 ▲"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4" Margin="0"
                                FontSize="11" Click="ToggleFilterBtn_Click"/>
                    </Grid>

                    <!-- 筛选内容区 -->
                    <StackPanel x:Name="FilterPanelContent" Grid.Row="1">
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 字段选择 -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="筛选字段"/>
                                <ComboBox x:Name="FieldComboBox" SelectedIndex="7">
                                    <ComboBoxItem Content="全部字段" Tag="A"/>
                                    <ComboBoxItem Content="订单号" Tag="O"/>
                                    <ComboBoxItem Content="柜号" Tag="C"/>
                                    <ComboBoxItem Content="房间" Tag="R"/>
                                    <ComboBoxItem Content="板件名称" Tag="N"/>
                                    <ComboBoxItem Content="材质" Tag="M"/>
                                    <ComboBoxItem Content="备注" Tag="B"/>
                                    <ComboBoxItem Content="实体ID" Tag="E"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 匹配方式 -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="匹配方式"/>
                                <ComboBox x:Name="MatchModeComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="包含" Tag="P"/>
                                    <ComboBoxItem Content="精确匹配" Tag="X"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 筛选值 -->
                            <StackPanel Grid.Column="2">
                                <Label Content="筛选值"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FilterValueBox" Padding="8,5" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             TextChanged="FilterValueBox_TextChanged"
                                             KeyDown="FilterValueBox_KeyDown"/>
                                    <Button x:Name="DoFilterBtn" Grid.Column="1" Content="筛选"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="12,5" Margin="6,0,0,0"
                                            Click="DoFilterBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- 快捷筛选标签 + 一键清除 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="快捷筛选:" VerticalAlignment="Center" FontSize="11" Foreground="#666666" Margin="0,0,8,0"/>
                                <Button Content="全部" Tag="A" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="2" FontSize="11"
                                        Click="QuickFilterTag_Click"/>
                                <Button Content="背板" Tag="N:背板" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="2" FontSize="11"
                                        Click="QuickFilterTag_Click"/>
                                <Button Content="侧板" Tag="N:侧板" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="2" FontSize="11"
                                        Click="QuickFilterTag_Click"/>
                                <Button Content="层板" Tag="N:层板" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="2" FontSize="11"
                                        Click="QuickFilterTag_Click"/>
                                <Button Content="门板" Tag="N:门板" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" Margin="2" FontSize="11"
                                        Click="QuickFilterTag_Click"/>
                            </StackPanel>
                            <Button x:Name="ClearAllFiltersBtn" Grid.Column="1" Content="清除全部"
                                    Style="{StaticResource DangerButton}"
                                    Padding="10,4" Margin="0" FontSize="11"
                                    Click="ClearAllFiltersBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === 结果统计栏 === -->
            <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="4" BorderBrush="#BFDBFE" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultCountText" Grid.Column="0"
                               Text="共找到 0 个板件" FontWeight="SemiBold"
                               FontSize="13" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SelectionHintText" Grid.Column="2"
                               Text="双击行定位板件 | Ctrl+单击多选 | Enter定位选中"
                               FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- === 结果列表 === -->
            <DataGrid x:Name="ResultGrid" Grid.Row="3"
                      MouseDoubleClick="ResultGrid_MouseDoubleClick"
                      SelectionChanged="ResultGrid_SelectionChanged"
                      KeyDown="ResultGrid_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模型ID" Binding="{Binding EntityId}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="板件名称" Binding="{Binding PanelName}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="柜号" Binding="{Binding CabinetId}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="房间" Binding="{Binding RoomId}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="计算类型" Binding="{Binding CalculationTypeName}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="长(mm)" Binding="{Binding Length, StringFormat=F1}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="宽(mm)" Binding="{Binding Width, StringFormat=F1}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="厚(mm)" Binding="{Binding Height, StringFormat=F1}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remarks}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空状态提示 -->
            <Border x:Name="EmptyStatePanel" Grid.Row="3" Visibility="Collapsed"
                    Background="White" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="未找到符合条件的板件" FontSize="16" Foreground="#9CA3AF"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="请尝试调整筛选条件，或使用模型ID精确查询" FontSize="12"
                               Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- === 底部分页 + 操作按钮 === -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 分页控制 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevPageBtn" Content="◀ 上一页"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Click="PrevPageBtn_Click"/>
                    <TextBlock x:Name="PageInfoText" Text="第 1 / 1 页"
                               VerticalAlignment="Center" Margin="12,0" FontSize="12"/>
                    <Button x:Name="NextPageBtn" Content="下一页 ▶"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6" Click="NextPageBtn_Click"/>
                    <TextBlock Text="每页" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="12"/>
                    <ComboBox x:Name="PageSizeComboBox" SelectedIndex="1" VerticalAlignment="Center"
                              SelectionChanged="PageSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="20" Tag="20"/>
                        <ComboBoxItem Content="50" Tag="50"/>
                        <ComboBoxItem Content="100" Tag="100"/>
                    </ComboBox>
                    <TextBlock Text="条" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="LocateBtn" Content="定位板件"
                            Style="{StaticResource PrimaryButton}"
                            Click="LocateBtn_Click" MinWidth="90"/>
                    <Button x:Name="EditBtn" Content="编辑板件"
                            Style="{StaticResource SecondaryButton}"
                            Click="EditBtn_Click" MinWidth="90"/>
                    <Button x:Name="RefreshBtn" Content="刷新列表"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshBtn_Click" MinWidth="90"/>
                    <Button x:Name="ExportBtn" Content="导出结果"
                            Style="{StaticResource SecondaryButton}"
                            Click="ExportBtn_Click" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
