<UserControl x:Class="FurniturePlugin.CommandPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    
    <Grid x:Name="MainGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Theme Selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="主题 (Theme): " VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeComboBox" Width="100" SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="1">
                <ComboBoxItem Content="黑色 (Black)" Tag="#FF1E1E1E"/>
                <ComboBoxItem Content="白色 (White)" Tag="#FFFFFFFF"/>
                <ComboBoxItem Content="绿色 (Green)" Tag="#FFE8F5E9"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                <TextBlock Text="常用命令快捷键" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                
                <GroupBox Header="板件管理 (Panel Management)">
                    <UniformGrid Columns="1">
                        <Button Content="设置板件信息 (SETI)" Click="Button_Click" Tag="SETI"/>
                        <Button Content="批量修改信息 (PLXG)" Click="Button_Click" Tag="PLXG"/>
                        <Button Content="查看信息列表 (CKLB)" Click="Button_Click" Tag="CKLB"/>
                        <Button Content="导出CSV (ExportPanelInfoToCsv)" Click="Button_Click" Tag="ExportPanelInfoToCsv"/>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="快速创建板件 (Quick Create)">
                    <StackPanel>
                        <Button Content="🏠 柜体创建器 (GTCJ)" Click="Button_Click" Tag="GTCJ" 
                                Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Height="40" FontSize="14"/>
                        <TextBlock Text="推荐：输入尺寸、选择盖法，一键生成完整柜体" 
                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,5"/>
                        
                        <Button Content="⚙ 板件参数设置 (BJCS)" Click="Button_Click" Tag="BJCS" 
                                Background="#FFE3F2FD" FontWeight="Bold" Height="35"/>
                        <UniformGrid Columns="2" Margin="0,5,0,0">
                            <Button Content="左右侧板" Click="Button_Click" Tag="ZYCEBAN"/>
                            <Button Content="顶底板" Click="Button_Click" Tag="DINDIBAN"/>
                            <Button Content="层板" Click="Button_Click" Tag="CENGBAN"/>
                            <Button Content="背板" Click="Button_Click" Tag="BEIBAN"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="其他创建 (Other Creation)">
                    <UniformGrid Columns="1">
                        <Button Content="快速创建板件 (CJBJ)" Click="Button_Click" Tag="CJBJ"/>
                        <Button Content="智能外框架 (KJ)" Click="Button_Click" Tag="KJ"/>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="工具 (Tools)">
                    <UniformGrid Columns="1">
                        <Button Content="查找板件 (CZBJ)" Click="Button_Click" Tag="CZBJ"/>
                        <Button Content="OBB包围盒 (OBB)" Click="Button_Click" Tag="OBB"/>
                        <Button Content="轴向拉伸 (AXS)" Click="Button_Click" Tag="AXS"/>
                        <Button Content="摆正板件 (BZBJ)" Click="Button_Click" Tag="BZBJ"/>
                        <Button Content="五视图投影 (NMST)" Click="Button_Click" Tag="NMST"/>
                        <Button Content="最小外框矩形 (ZXWK)" Click="Button_Click" Tag="ZXWK"/>
                        <Button Content="排版 (PAIBAN)" Click="Button_Click" Tag="PAIBAN"/>
                        <Button Content="差集运算 (SUU)" Click="Button_Click" Tag="SUU"/>
                        <Button Content="内空识别 (BOO)" Click="Button_Click" Tag="BOO"/>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="材质与显示 (Materials)">
                    <UniformGrid Columns="1">
                        <Button Content="测试材质 (TESTMAT)" Click="Button_Click" Tag="TESTMAT"/>
                        <Button Content="材质库 (TESTMATLIB)" Click="Button_Click" Tag="TESTMATLIB"/>
                        <Button Content="纹理方向 (ShowAllTextureDirections)" Click="Button_Click" Tag="ShowAllTextureDirections"/>
                    </UniformGrid>
                </GroupBox>

                <Expander Header="测试命令 (Test Commands)" Margin="2">
                    <UniformGrid Columns="1">
                        <Button Content="运行所有测试 (TESTALL)" Click="Button_Click" Tag="TESTALL"/>
                        <Button Content="测试数据 (TESTDATA)" Click="Button_Click" Tag="TESTDATA"/>
                        <Button Content="测试创建 (TESTCREATE)" Click="Button_Click" Tag="TESTCREATE"/>
                        <Button Content="测试命令 (TESTCMD)" Click="Button_Click" Tag="TESTCMD"/>
                        <Button Content="性能测试 (TESTPERF)" Click="Button_Click" Tag="TESTPERF"/>
                        <Button Content="清理数据 (TESTCLEAN)" Click="Button_Click" Tag="TESTCLEAN"/>
                        <Button Content="测试帮助 (TESTHELP)" Click="Button_Click" Tag="TESTHELP"/>
                        <Button Content="测试外框架 (TESTKJ)" Click="Button_Click" Tag="TESTKJ"/>
                    </UniformGrid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
