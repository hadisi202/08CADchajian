	[CommandMethod("PLXG")]
	public void SetPanelInfoBatch()
	{
		try
		{
			Document mdiActiveDocument = Application.DocumentManager.MdiActiveDocument;
			if (mdiActiveDocument == null)
			{
				System.Windows.MessageBox.Show("没有活动的 AutoCAD 文档。", "错误", MessageBoxButton.OK, MessageBoxImage.Hand);
				return;
			}
			Database database = mdiActiveDocument.Database;
			Editor editor = mdiActiveDocument.Editor;
			RestorePreviousHighlight(database);
			PromptSelectionOptions val = new PromptSelectionOptions
			{
				MessageForAdding = "\n璇烽€夋嫨瑕佹壒閲忓鐞嗙殑3D瀹炰綋鏉夸欢: ",
				MessageForRemoval = "\n绉婚櫎閫夋嫨: "
			};
			SelectionFilter val2 = new SelectionFilter((TypedValue[])(object)new TypedValue[1]
			{
				new TypedValue(0, (object)"3DSOLID")
			});
			PromptSelectionResult selection = editor.GetSelection(val, val2);
			if ((int)selection.Status != 5100)
			{
				if ((int)selection.Status == -5002)
				{
					editor.WriteMessage("\n鎿嶄綔宸插彇娑堛€?");
				}
				return;
			}
			SelectionSet value = selection.Value;
			ObjectId[] objectIds = value.GetObjectIds();
			if (objectIds.Length == 0)
			{
				editor.WriteMessage("\n娌℃湁閫夋嫨浠讳綍鏉夸欢銆?");
				return;
			}
			editor.WriteMessage($"\n宸查€夋嫨 {objectIds.Length} 涓?D瀹炰綋銆?");
			List<BatchEditItem> list = new List<BatchEditItem>();
			Transaction val3 = database.TransactionManager.StartTransaction();
			try
			{
				ObjectId[] array = objectIds;
				for (int i = 0; i < array.Length; i++)
				{
					ObjectId val4 = array[i];
					try
					{
						DBObject obj = val3.GetObject(val4, (OpenMode)0);
						Solid3d val5 = (Solid3d)(object)((obj is Solid3d) ? obj : null);
						if (val5 != null)
						{
							PanelInfo panelInfo = GetPanelInfo((DBObject)val5) ?? new PanelInfo();
							PanelInfoListItem panelInfoListItem = new BatchEditItem();
							Handle handle = val4.Handle;
							item.EntityId = handle.Value.ToString();
							item.OrderId = panelInfo.OrderId;
							item.CabinetId = panelInfo.CabinetId;
							item.PanelName = panelInfo.PanelName;
							item.Material = panelInfo.Material;
							item.Length = panelInfo.Length;
							item.Width = panelInfo.Width;
							item.Height = panelInfo.Height;
							item.EdgeBanding = panelInfo.EdgeBanding;
							item.Paint = panelInfo.Paint;
							item.IsArcPanel = panelInfo.IsArcPanel;
							BatchEditItem bitem = item;
							list.Add(item);
						}
					}
					catch (Exception ex)
					{
						editor.WriteMessage($"\n璇诲彇瀹炰綋 {val4} 淇℃伅鏃跺嚭閿? {ex.Message}");
					}
				}
				val3.Commit();
			}
			finally
			{
				((IDisposable)val3)?.Dispose();
			}
			try
			{
				BatchEditWindow batchEditWindow = new BatchEditWindow(list);
				WindowInteropHelper windowInteropHelper = new WindowInteropHelper(batchEditWindow)
				{
					Owner = Application.MainWindow.Handle
				};
				if (batchEditWindow.ShowDialog() != true)
				{
					editor.WriteMessage("\n鎵归噺鎿嶄綔宸插彇娑堛€?");
				}
				else
				{
					editor.WriteMessage("\n鎵归噺淇敼鎿嶄綔瀹屾垚銆?");
				}
			}
			catch (Exception ex2)
			{
				editor.WriteMessage("\n鏄剧ず鎵归噺璁剧疆绐楀彛鏃跺嚭閿? " + ex2.Message);
			}
		}
		catch (Exception ex3)
		{
			Document mdiActiveDocument2 = Application.DocumentManager.MdiActiveDocument;
			Editor val6 = ((mdiActiveDocument2 != null) ? mdiActiveDocument2.Editor : null);
			if (val6 != null)
			{
				val6.WriteMessage("\n鎵ц鎵归噺澶勭悊鍛戒护鏃跺嚭閿? " + ex3.Message);
			}
			System.Windows.MessageBox.Show("鎵ц鎵归噺澶勭悊鏃跺嚭閿? " + ex3.Message, "閿欒", MessageBoxButton.OK, MessageBoxImage.Hand);
		}
	}

