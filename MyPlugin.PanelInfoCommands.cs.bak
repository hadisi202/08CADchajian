	[CommandMethod("TESTMATLIB")]
	public void TestMaterialLibrary()
	{
		Document mdiActiveDocument = Application.DocumentManager.MdiActiveDocument;
		Database database = mdiActiveDocument.Database;
		Editor editor = mdiActiveDocument.Editor;
		try
		{
			editor.WriteMessage("\n=== 娴嬭瘯绯荤粺鏉愯川搴撳姛鑳?===");
			Transaction val = database.TransactionManager.StartTransaction();
			try
			{
				DBDictionary val2 = (DBDictionary)val.GetObject(database.MaterialDictionaryId, (OpenMode)0);
				editor.WriteMessage($"\n褰撳墠鏉愯川瀛楀吀涓湁 {val2.Count} 涓潗璐?");
				DbDictionaryEnumerator enumerator = val2.GetEnumerator();
				try
				{
					while (enumerator.MoveNext())
					{
						DictionaryEntry dictionaryEntry = (DictionaryEntry)enumerator.Current;
						editor.WriteMessage($"\n  - {dictionaryEntry.Key}");
					}
				}
				finally
				{
					((IDisposable)enumerator)?.Dispose();
				}
				string[] array = new string[4] { "橡木", "樱桃木", "松木", "胡桃木" };
				string[] array2 = array;
				foreach (string text in array2)
				{
					editor.WriteMessage("\n\n娴嬭瘯鏉愯川: " + text);
					ObjectId val3 = ObjectId.Null;
					if (val3 != ObjectId.Null)
					{
						editor.WriteMessage("  鉁?鎴愬姛鑾峰彇/鍒涘缓鏉愯川: " + text);
					}
					else
					{
						editor.WriteMessage("  鉁?鏃犳硶鑾峰彇/鍒涘缓鏉愯川: " + text);
					}
				}
				val.Commit();
			}
			finally
			{
				((IDisposable)val)?.Dispose();
			}
			editor.WriteMessage("\n\n=== 鏉愯川搴撴祴璇曞畬鎴?===");
			editor.WriteMessage("\n鎻愮ず锛氫娇鐢?TESTMAT 鍛戒护灏嗘潗璐ㄥ簲鐢ㄥ埌閫変腑鐨勫疄浣撲笂銆?");
		}
		catch (Exception ex)
		{
			editor.WriteMessage("\n娴嬭瘯鏉愯川搴撴椂鍑洪敊: " + ex.Message);
		}
	}

	[CommandMethod("ShowAllTextureDirections")]
	public void ShowAllTextureDirections()
	{
		try
		{
			Document mdiActiveDocument = Application.DocumentManager.MdiActiveDocument;
			if (mdiActiveDocument == null)
			{
				System.Windows.MessageBox.Show("没有活动的 AutoCAD 文档。", "错误", MessageBoxButton.OK, MessageBoxImage.Hand);
				return;
			}
			Database database = mdiActiveDocument.Database;
			Editor editor = mdiActiveDocument.Editor;
			RestorePreviousHighlight(database);
			Transaction val = database.TransactionManager.StartTransaction();
			try
			{
				BlockTable val2 = (BlockTable)val.GetObject(database.BlockTableId, (OpenMode)0);
				BlockTableRecord val3 = (BlockTableRecord)val.GetObject(((SymbolTable)val2)[BlockTableRecord.ModelSpace], (OpenMode)0);
				int num = 0;
				BlockTableRecordEnumerator enumerator = val3.GetEnumerator();
				try
				{
					while (enumerator.MoveNext())
					{
						ObjectId current = enumerator.Current;
						DBObject obj = val.GetObject(current, (OpenMode)0);
						Solid3d val4 = (Solid3d)(object)((obj is Solid3d) ? obj : null);
						if (val4 != null)
						{
							PanelInfo panelInfo = GetPanelInfo((DBObject)val4);
							if (panelInfo != null && panelInfo.TextureDirection != TextureDirection.AlongLength)
							{
								editor.WriteMessage($"\n瀹炰綋 {current}: 绾圭悊鏂瑰悜 = {panelInfo.TextureDirection}");
								num++;
							}
						}
					}
				}
				finally
				{
					((IDisposable)enumerator)?.Dispose();
				}
				val.Commit();
				editor.WriteMessage($"\n鍏辨壘鍒?{num} 涓缃簡绾圭悊鏂瑰悜鐨勬澘浠躲€?");
			}
			finally
			{
				((IDisposable)val)?.Dispose();
			}
		}
		catch (Exception ex)
		{
			Document mdiActiveDocument2 = Application.DocumentManager.MdiActiveDocument;
			Editor val5 = ((mdiActiveDocument2 != null) ? mdiActiveDocument2.Editor : null);
			if (val5 != null)
			{
				val5.WriteMessage("\n鏄剧ず绾圭悊鏂瑰悜鏃跺嚭閿? " + ex.Message);
			}
		}
	}

	[CommandMethod("CKBJ")]
	public void CKBJ()
	{
		try
		{
			Document mdiActiveDocument = Application.DocumentManager.MdiActiveDocument;
			if (mdiActiveDocument == null)
			{
				System.Windows.MessageBox.Show("没有活动的 AutoCAD 文档。", "错误", MessageBoxButton.OK, MessageBoxImage.Hand);
				return;
			}
			Database database = mdiActiveDocument.Database;
			Editor editor = mdiActiveDocument.Editor;
			RestorePreviousHighlight(database);
			PromptSelectionOptions val = new PromptSelectionOptions
			{
				MessageForAdding = "\n璇烽€夋嫨瑕佹煡鐪嬬殑3D瀹炰綋鏉夸欢: ",
				MessageForRemoval = "\n绉婚櫎閫夋嫨: "
			};
			SelectionFilter val2 = new SelectionFilter((TypedValue[])(object)new TypedValue[1]
			{
				new TypedValue(0, (object)"3DSOLID")
			});
			PromptSelectionResult selection = editor.GetSelection(val, val2);
			if ((int)selection.Status != 5100)
			{
				if ((int)selection.Status == -5002)
				{
					editor.WriteMessage("\n鎿嶄綔宸插彇娑堛€?");
				}
				return;
			}
			ObjectId[] objectIds = selection.Value.GetObjectIds();
			if (objectIds.Length == 0)
			{
				editor.WriteMessage("\n娌℃湁閫夋嫨浠讳綍鏉夸欢銆?");
				return;
			}
			editor.WriteMessage($"\n宸查€夋嫨 {objectIds.Length} 涓?D瀹炰綋杩涜鏌ョ湅銆?");
			try
			{
				PanelInfoListWindow panelInfoListWindow = new PanelInfoListWindow(new List<ObjectId>(objectIds));
				WindowInteropHelper windowInteropHelper = new WindowInteropHelper(panelInfoListWindow)
				{
					Owner = Application.MainWindow.Handle
				};
				panelInfoListWindow.ShowDialog();
			}
			catch (Exception ex)
			{
				editor.WriteMessage("\n鏄剧ず鏉夸欢淇℃伅鍒楄〃绐楀彛鏃跺嚭閿? " + ex.Message);
			}
		}
		catch (Exception ex2)
		{
			Document mdiActiveDocument2 = Application.DocumentManager.MdiActiveDocument;
			Editor val3 = ((mdiActiveDocument2 != null) ? mdiActiveDocument2.Editor : null);
			if (val3 != null)
			{
				val3.WriteMessage("\n鎵цCKBJ鍛戒护鏃跺嚭閿? " + ex2.Message);
			}
			System.Windows.MessageBox.Show("鎵цCKBJ鍛戒护鏃跺嚭閿? " + ex2.Message, "閿欒", MessageBoxButton.OK, MessageBoxImage.Hand);
		}
	}
}

